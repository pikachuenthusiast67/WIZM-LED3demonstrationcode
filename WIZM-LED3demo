from machine import Pin
import time

red = Pin(4, Pin.OUT)
yellow = Pin(5, Pin.OUT)
green = Pin(6, Pin.OUT)

def set_lights(r, y, g):
    red.value(r)
    yellow.value(y)
    green.value(g)

while True:
    # Green Phase
    set_lights(0, 0, 1)
    time.sleep(5)

    # Yellow Phase
    set_lights(0, 1, 0)
    time.sleep(2)

    # Red Phase
    set_lights(1, 0, 0)
    time.sleep(5)
